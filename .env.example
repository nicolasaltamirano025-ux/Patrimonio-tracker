# Variables de entorno para las Netlify Functions (netlify/functions/daily-alerts.js
# y netlify/functions/migrate-user-data.js). Configúralas en Netlify → Site settings
# → Environment variables. No se usan en el cliente (el firebaseConfig del index.html
# es público por diseño, ver README).

# Service account de Firebase (Project settings → Service accounts → Generate new private key),
# codificado en base64: cat serviceAccount.json | base64 -w0
FIREBASE_SERVICE_ACCOUNT_B64=

# URL de tu Realtime Database
FIREBASE_DB_URL=https://patrimonio-tracker-3b1ee-default-rtdb.firebaseio.com

# API key de Resend (resend.com) para enviar los correos de alerta
RESEND_API_KEY=

# Remitente verificado en Resend
ALERT_FROM_EMAIL=alerts@tudominio.com

# Secreto para proteger netlify/functions/migrate-user-data.js (solo se usa una vez,
# para la migración inicial). Invéntate cualquier cadena larga y aleatoria.
MIGRATION_SECRET=

